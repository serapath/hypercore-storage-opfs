{
  "name": "rocksdb-native-opfs",
  "version": "0.1.0",
  "description": "rocksdb-native's native binding reimplemented in plain JavaScript on OPFS, so hypercore-storage can run in browsers",
  "main": "index.js",
  "license": "Apache-2.0",
  "files": [
    "index.js",
    "lib/",
    "browser/",
    "opfs-node/"
  ],
  "scripts": {
    "fetch-upstream": "node scripts/fetch-upstream.js",
    "test": "node test/run.js unit && node test/run.js rocksdb-native && node test/run.js hypercore-storage && node test/run.js hypercore && node test/run.js fuzz && npm run test:bundle",
    "test:unit": "node test/run.js unit",
    "test:rocksdb": "node test/run.js rocksdb-native",
    "test:storage": "node test/run.js hypercore-storage",
    "test:fuzz": "node test/run.js fuzz",
    "build:browser-test": "node scripts/build-browser-test.js",
    "test:bundle": "node scripts/build-browser-test.js && node test/bundle.js",
    "test:hypercore": "node test/run.js hypercore"
  },
  "peerDependencies": {
    "rocksdb-native": "3.19.x"
  },
  "devDependencies": {
    "b4a": "^1.6.7",
    "brittle": "^3.7.0",
    "buffer": "^6.0.3",
    "compact-encoding": "^3.1.0",
    "debugging-stream": "^3.1.0",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "fd-lock": "^2.1.1",
    "hypercore": "^11.39.0",
    "hypercore-crypto": "^3.4.2",
    "hypercore-storage": "3.4.0",
    "hyperswarm": "^4.17.2",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "rache": "^1.0.0",
    "range-parser": "^1.3.0",
    "resolve-reject-promise": "^1.1.0",
    "rocksdb-native": "3.19.1",
    "sodium-javascript": "^0.8.0",
    "speedometer": "^1.1.0",
    "test-tmp": "^1.3.1",
    "tiny-byte-size": "^1.1.0",
    "udx-native": "^1.21.3",
    "uncaughts": "^1.1.3"
  }
}
